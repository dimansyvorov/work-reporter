# Copy to .env and fill in. Or run demo without API:
#   cp team.json.example team.json
#   python run.py --mock
#
# Team / projects / boards / thresholds live in team.json
# (copy from team.json.example; file is gitignored):
#   - people, directions, gitlab_projects, gitlab_days
#   - jira.projects / jira.boards (has_sprints: false for kanban)
#   - metrics / ratings / ui

GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxx

# Optional override of team.json → gitlab_days (fallback lookback if no Jira sprint)
# GITLAB_DAYS=30

# Optional override for GitLab project→direction (base map is in team.json)
# GITLAB_DIRECTION_MAP=group/mobile-app:Мобильная разработка

JIRA_URL=https://jira.example.com
JIRA_TOKEN=xxxxxxxx
# Cloud:
# JIRA_EMAIL=you@company.com
# Server/DC basic auth fallback:
# JIRA_USER=your.login

JIRA_EXPECTED_HOURS_PER_DAY=8

HOST=127.0.0.1
PORT=8765

# Publish to home server (python run.py --publish)
# PUBLISH_SSH=server
# PUBLISH_REMOTE_DIR=/home/USER/path/to/sprint-report
# PUBLISH_PUBLIC_URL=https://your.domain.example/report/
# Telegram notify runs ON THE SERVER only (token stays there).
# Path is remote (server home), not the Mac path:
# PUBLISH_NOTIFY_SCRIPT=~/work-reporter-notify/notify-telegram.sh

# Corporate LLM sprint brief (called on Mac during collect; result is static JSON)
# CORP_LLM_ENABLED=1
# CORP_LLM_URL=https://litellm-dev.sberbank-service.ru/chat/completions
# CORP_LLM_TOKEN=sk-u-xxxxxxxx
# CORP_LLM_MODEL=/models/Qwen3.6
# CORP_LLM_TEMPERATURE=0.2
# CORP_LLM_TIMEOUT_SEC=45
# CORP_LLM_CACHE_SEC=3000
